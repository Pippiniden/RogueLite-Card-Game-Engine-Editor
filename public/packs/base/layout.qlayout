  PO1 frame 56,264 278x160 "説明" bind="potion.info"
  PO2 button 56,440 278x48 "使う" bind="potion.use" skin="button.primary" on="tap: usePotion"
  PO3 button 56,496 134x48 "捨てる" on="tap: discardPotion"
