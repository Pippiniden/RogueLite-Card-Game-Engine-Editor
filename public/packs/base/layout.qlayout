#QLAYOUT 1
project "RogueLite Card Game Engine & Editor（基本パック: 灯火の回廊）"
size 390x844
safe 47,0,34,0
url "https://claude.ai/artifact/BPbQY32juVG7jRKZCkwbvb"
attr skin "UIスキンの部品名（theme.json の skins。画像があれば9スライス、無ければCSS）"
context "Slay the Spire 型ローグライトのエンジン。縦持ち固定・フロントビュー（主人公は描かず顔グラフィックで表す）。会話は日本語"
context "ゲームは packs/base/layout.qlayout をこのツールと同じパーサで読み、ここの位置そのままで画面を組む"
context "画面ID = ゲームの場面: TITLE CHARSELECT MAP BATTLE REWARD REST RESULT（宝箱は REWARD を使う。CHARSELECT は主人公が2人以上の時だけ出る）"
context "bind = ゲーム側の部品名（src/game/widgets.ts に登録済みの名前）。bind の無い label/text/button は label の文字をそのまま出す"
context "on = \"tap: アクション(引数) → 遷移先\"。アクションは src/game/actions.ts。open → X / close → X で重ね表示を開閉"
context "show = フラグ名。フラグが立っている時だけ表示（hasSave, restDone, info, banner, choice など）"
end

screen TITLE 390x844 "タイトル"
note "背景は全面。主人公の顔は character.portrait の normal"
A image 0,0 390x844 "背景" bind="title.bg"
  B label 24,112 342x64 "ゲームタイトル" bind="title.name"
  C label 24,176 342x24 "サブタイトル" bind="title.sub"
  D image 79,224 232x232 "主人公の顔" bind="title.portrait"
  E text 40,472 310x56 "主人公の紹介" bind="title.intro"
  F button 64,584 262x56 "はじめから" bind="title.start" skin="button.primary" on="tap: newRun"
  G button 64,656 262x56 "つづきから" show="hasSave" on="tap: continueRun → MAP"
  H button 120,736 150x40 "記録を消す" show="hasSave" on="tap: abandonRun"
  I button 326,56 48x40 "音のオン・オフ" bind="sound.toggle" on="tap: toggleSound"
end

screen CHARSELECT 390x844 "主人公選択"
note "主人公が2人以上いる時だけ表示。1人ならタイトルからそのままマップへ"
A image 0,0 390x844 "背景" bind="title.bg"
  B label 24,56 342x40 "見出し" bind="charselect.title"
  C image 59,104 272x272 "選んでいる主人公" bind="charselect.art"
  D label 24,384 342x40 "名前と肩書" bind="charselect.name"
  E text 24,424 342x104 "紹介と初期ステータス" bind="charselect.info"
  F list 16,536 358x96 "主人公の一覧" bind="charselect.list" layout="row gap=8" scroll="x"
  G button 64,664 262x56 "出発する" skin="button.primary" on="tap: startRun → MAP"
  H button 120,736 150x40 "戻る" on="tap: → TITLE"
end

screen MAP 390x844 "マップ"
note "下から上へ進む。進める場所だけが光ってタップできる"
A frame 0,47 390x56 "上部バー" skin="topbar"
  A1 image 12,51 48x48 "顔" bind="player.face"
  A2 label 68,55 120x20 "名前" bind="player.name"
  A3 gauge 68,79 120x16 "HP" bind="player.hp"
  A4 label 196,59 64x32 "階層" bind="run.floor"
  A5 label 264,59 64x32 "所持金" bind="run.gold"
  A6 button 334,55 48x40 "デッキ" bind="deck.button" on="tap: open → X"
B list 0,103 390x32 "レリック" bind="run.relics" layout="row gap=4"
C canvas 0,135 390x675 "マップ" bind="map" scroll="y"
X dialog 16,103 358x707 "デッキ一覧" layer="overlay"
  X1 label 32,119 326x32 "見出し" bind="deck.title"
  X2 grid 32,159 326x571 "カード" bind="deck.cards" scroll="y" layout="grid cols=3 gap=8"
  X3 button 32,746 326x48 "閉じる" on="tap: close → X"
I dialog 24,224 342x400 "詳細" layer="overlay" show="info"
  I1 frame 40,240 310x312 "内容" bind="info.body" scroll="y"
  I2 button 40,568 310x40 "閉じる" on="tap: close → I"
end

screen BATTLE 390x844 "戦闘"
note "フロントビュー。主人公は描かず、被ダメージは画面の揺れと赤い縁で表す"
note "カードはタップで選択→敵をタップで使用。上へスワイプでも使える。長押しで詳細"
A frame 0,47 390x56 "上部バー" skin="topbar"
  A1 label 12,59 96x32 "階層" bind="run.floor"
  A2 label 112,59 96x32 "所持金" bind="run.gold"
  A3 button 334,55 48x40 "デッキ" bind="deck.button" on="tap: open → X"
B list 0,103 390x32 "レリック" bind="run.relics" layout="row gap=4"
C canvas 0,135 390x345 "敵の配置領域" bind="enemies" note="rules.json の formations で並べる。意図は頭上、HPと状態は足元"
D frame 8,480 374x76 "プレイヤーの状態"
  D1 image 16,484 68x68 "顔" bind="player.face" note="被弾で hurt、HP30%以下で pinch、勝利で happy"
  D2 gauge 92,488 282x22 "HPとブロック" bind="player.hpBlock"
  D3 list 92,518 282x28 "状態異常" bind="player.statuses" layout="row gap=4"
E frame 8,560 374x56 "エネルギーと山札"
  E1 icon 16,560 56x56 "エネルギー" bind="battle.energy"
  E2 button 80,568 72x40 "山札" bind="pile.draw" on="tap: showPile(draw) → Y"
  E3 button 160,568 72x40 "捨て札" bind="pile.discard" on="tap: showPile(discard) → Y"
  E4 button 262,564 112x48 "ターン終了" bind="battle.endTurn" skin="button.primary" on="tap: endTurn"
F canvas 0,620 390x190 "手札" bind="hand"
X dialog 16,103 358x707 "デッキ一覧" layer="overlay"
  X1 label 32,119 326x32 "見出し" bind="deck.title"
  X2 grid 32,159 326x571 "カード" bind="deck.cards" scroll="y" layout="grid cols=3 gap=8"
  X3 button 32,746 326x48 "閉じる" on="tap: close → X"
Y dialog 16,103 358x707 "山札・捨て札" layer="overlay"
  Y1 label 32,119 326x32 "見出し" bind="pile.title"
  Y2 grid 32,159 326x571 "カード" bind="pile.cards" scroll="y" layout="grid cols=3 gap=8"
  Y3 button 32,746 326x48 "閉じる" on="tap: close → Y"
I dialog 24,224 342x400 "詳細" layer="overlay" show="info"
  I1 frame 40,240 310x312 "内容" bind="info.body" scroll="y"
  I2 button 40,568 310x40 "閉じる" on="tap: close → I"
M label 0,272 390x64 "ターンの表示" layer="overlay" show="banner" bind="battle.banner" skin="banner" note="「敵のターン」「対象を選ぶ」などを短く出す"
S dialog 16,312 358x448 "カードを選ぶ" layer="overlay" show="choice" note="「手札から1枚廃棄する」などでカードを選ぶ時に出る。閉じられない"
  S1 label 32,328 326x40 "案内文" bind="choice.prompt"
  S2 grid 32,376 326x304 "候補のカード" bind="choice.cards" scroll="y" layout="grid cols=3 gap=8"
  S3 button 32,696 326x48 "決定" bind="choice.confirm" skin="button.primary" on="tap: confirmChoice"
end

screen REWARD 390x844 "報酬"
note "戦闘の勝利と宝箱の両方で使う"
A frame 0,47 390x56 "上部バー" skin="topbar"
  A1 image 12,51 48x48 "顔" bind="player.face"
  A2 label 68,55 120x20 "名前" bind="player.name"
  A3 gauge 68,79 120x16 "HP" bind="player.hp"
  A4 label 196,59 64x32 "階層" bind="run.floor"
  A5 label 264,59 64x32 "所持金" bind="run.gold"
  A6 button 334,55 48x40 "デッキ" bind="deck.button" on="tap: open → X"
B list 0,103 390x32 "レリック" bind="run.relics" layout="row gap=4"
C label 24,151 342x48 "見出し" bind="reward.title"
D list 24,207 342x128 "報酬の一覧" bind="reward.items" layout="column gap=8" note="ゴールド・レリック。タップで受け取る"
E label 24,351 342x24 "カード選択の見出し" bind="reward.cardTitle"
F grid 24,383 342x184 "カード候補" bind="reward.cards" repeat="3x1"
G button 24,688 342x56 "次へ" bind="reward.next" on="tap: leaveNode → MAP"
X dialog 16,103 358x707 "デッキ一覧" layer="overlay"
  X1 label 32,119 326x32 "見出し" bind="deck.title"
  X2 grid 32,159 326x571 "カード" bind="deck.cards" scroll="y" layout="grid cols=3 gap=8"
  X3 button 32,746 326x48 "閉じる" on="tap: close → X"
I dialog 24,224 342x400 "詳細" layer="overlay" show="info"
  I1 frame 40,240 310x312 "内容" bind="info.body" scroll="y"
  I2 button 40,568 310x40 "閉じる" on="tap: close → I"
end

screen REST 390x844 "焚き火"
A frame 0,47 390x56 "上部バー" skin="topbar"
  A1 image 12,51 48x48 "顔" bind="player.face"
  A2 label 68,55 120x20 "名前" bind="player.name"
  A3 gauge 68,79 120x16 "HP" bind="player.hp"
  A4 label 196,59 64x32 "階層" bind="run.floor"
  A5 label 264,59 64x32 "所持金" bind="run.gold"
  A6 button 334,55 48x40 "デッキ" bind="deck.button" on="tap: open → X"
B list 0,103 390x32 "レリック" bind="run.relics" layout="row gap=4"
C image 95,151 200x200 "焚き火の絵" bind="rest.art"
D label 24,367 342x40 "見出し" bind="rest.title"
E button 24,423 167x128 "休む" bind="rest.heal" on="tap: restHeal"
F button 199,423 167x128 "鍛える" bind="rest.upgrade" on="tap: open → U"
G button 24,688 342x56 "マップへ進む" show="restDone" on="tap: leaveNode → MAP"
U dialog 16,103 358x707 "強化するカードを選ぶ" layer="overlay"
  U1 label 32,119 326x32 "見出し" bind="upgrade.title"
  U2 grid 32,159 326x571 "カード" bind="upgrade.cards" scroll="y" layout="grid cols=3 gap=8"
  U3 button 32,746 326x48 "閉じる" on="tap: close → U"
X dialog 16,103 358x707 "デッキ一覧" layer="overlay"
  X1 label 32,119 326x32 "見出し" bind="deck.title"
  X2 grid 32,159 326x571 "カード" bind="deck.cards" scroll="y" layout="grid cols=3 gap=8"
  X3 button 32,746 326x48 "閉じる" on="tap: close → X"
I dialog 24,224 342x400 "詳細" layer="overlay" show="info"
  I1 frame 40,240 310x312 "内容" bind="info.body" scroll="y"
  I2 button 40,568 310x40 "閉じる" on="tap: close → I"
end

screen RESULT 390x844 "結果"
A image 79,128 232x232 "主人公の顔" bind="result.portrait"
B label 24,384 342x56 "勝敗" bind="result.title"
C text 24,448 342x72 "記録" bind="result.stats"
D button 64,688 262x56 "タイトルへ" on="tap: toTitle → TITLE"
end
